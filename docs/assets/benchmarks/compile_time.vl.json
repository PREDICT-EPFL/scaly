{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "sweep.summary.csv"
  },
  "transform": [
    {
      "filter": "datum.successful > 0"
    },
    {
      "filter": "indexof(['casadi_mx_gemm_classic', 'casadi_mx_gemm_blasfeo'], datum.backend) < 0"
    },
    {
      "calculate": "datum.workload === 'race_cars' ? '0' : datum.workload === 'npmpc' ? '1' : datum.workload === 'chain' ? '2' : datum.workload === 'unbumpercars' ? '3' : ''",
      "as": "order"
    },
    {
      "calculate": "datum.workload === 'race_cars' ? 'Race-car MPC, horizon N' : datum.workload === 'npmpc' ? 'Neural-process MPC, horizon N' : datum.workload === 'chain' ? 'Chain of masses, M masses' : datum.workload === 'unbumpercars' ? 'Unbumpercars filter, C cars' : ''",
      "as": "problem"
    },
    {
      "calculate": "datum.backend === 'scaly' ? 'Scaly' : datum.backend === 'casadi_sx' ? 'CasADi SX' : datum.backend === 'casadi_mx' ? 'CasADi MX' : datum.backend === 'casadi_call_mx' ? 'CasADi MX with calls' : datum.backend === 'casadi_map_sx' ? 'CasADi mapped SX' : datum.backend === 'casadi_mx_gemm' ? 'CasADi MX with GEMM' : '' || datum.backend",
      "as": "encoding"
    },
    {
      "calculate": "datum.kernel_compile_ms_mean / 1000",
      "as": "value"
    }
  ],
  "facet": {
    "field": "problem",
    "type": "nominal",
    "title": null,
    "sort": {
      "field": "order",
      "op": "min"
    }
  },
  "columns": 2,
  "resolve": {
    "scale": {
      "x": "independent",
      "y": "independent"
    }
  },
  "spec": {
    "width": 300,
    "height": 190,
    "layer": [
      {
        "mark": "line",
        "encoding": {
          "x": {
            "field": "size",
            "type": "quantitative",
            "title": "Size",
            "scale": {
              "type": "log",
              "nice": false
            },
            "axis": {
              "format": "~g",
              "grid": false,
              "tickCount": 6
            }
          },
          "y": {
            "field": "value",
            "type": "quantitative",
            "title": "Kernel compile time, s",
            "scale": {
              "type": "log"
            },
            "axis": {
              "format": "~g",
              "labelExpr": "abs(log(datum.value) / LN10 - round(log(datum.value) / LN10)) < 1e-6 ? datum.label : ''",
              "gridOpacity": {
                "condition": {
                  "test": "abs(log(datum.value) / LN10 - round(log(datum.value) / LN10)) < 1e-6",
                  "value": 1
                },
                "value": 0
              }
            }
          },
          "color": {
            "field": "encoding",
            "title": null,
            "scale": {
              "domain": [
                "Scaly",
                "CasADi SX",
                "CasADi MX",
                "CasADi MX with calls",
                "CasADi mapped SX",
                "CasADi MX with GEMM"
              ],
              "range": [
                "#1baf7a",
                "#eb6834",
                "#2a78d6",
                "#eda100",
                "#e87ba4",
                "#4a3aa7"
              ]
            }
          }
        }
      },
      {
        "mark": {
          "type": "point",
          "stroke": "#ffffff",
          "strokeWidth": 1.5
        },
        "encoding": {
          "x": {
            "field": "size",
            "type": "quantitative",
            "title": "Size",
            "scale": {
              "type": "log",
              "nice": false
            },
            "axis": {
              "format": "~g",
              "grid": false,
              "tickCount": 6
            }
          },
          "y": {
            "field": "value",
            "type": "quantitative",
            "title": "Kernel compile time, s",
            "scale": {
              "type": "log"
            },
            "axis": {
              "format": "~g",
              "labelExpr": "abs(log(datum.value) / LN10 - round(log(datum.value) / LN10)) < 1e-6 ? datum.label : ''",
              "gridOpacity": {
                "condition": {
                  "test": "abs(log(datum.value) / LN10 - round(log(datum.value) / LN10)) < 1e-6",
                  "value": 1
                },
                "value": 0
              }
            }
          },
          "color": {
            "field": "encoding",
            "title": null,
            "scale": {
              "domain": [
                "Scaly",
                "CasADi SX",
                "CasADi MX",
                "CasADi MX with calls",
                "CasADi mapped SX",
                "CasADi MX with GEMM"
              ],
              "range": [
                "#1baf7a",
                "#eb6834",
                "#2a78d6",
                "#eda100",
                "#e87ba4",
                "#4a3aa7"
              ]
            }
          },
          "shape": {
            "field": "encoding",
            "title": null,
            "scale": {
              "domain": [
                "Scaly",
                "CasADi SX",
                "CasADi MX",
                "CasADi MX with calls",
                "CasADi mapped SX",
                "CasADi MX with GEMM"
              ],
              "range": [
                "circle",
                "square",
                "triangle-up",
                "diamond",
                "triangle-down",
                "cross"
              ]
            }
          },
          "tooltip": [
            {
              "field": "encoding",
              "title": "Encoding"
            },
            {
              "field": "size",
              "title": "Size"
            },
            {
              "field": "value",
              "title": "Kernel compile time, s",
              "format": ",.4~r"
            }
          ]
        }
      },
      {
        "mark": {
          "type": "rule",
          "strokeWidth": 1
        },
        "encoding": {
          "y": {
            "datum": 180
          }
        }
      }
    ]
  }
}
