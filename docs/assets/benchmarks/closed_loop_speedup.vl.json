{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "closed_loop_speedup.summary.csv"
  },
  "transform": [
    {
      "calculate": "datum.problem === 'race_cars' ? 'Race-car' : datum.problem === 'npmpc' ? 'Neural-process MPC' : datum.problem === 'chain' ? 'Chain' : datum.problem === 'unbumpercars' ? 'Unbumpercars' : ''",
      "as": "name"
    },
    {
      "calculate": "datum.problem === 'race_cars' ? '0' : datum.problem === 'npmpc' ? '1' : datum.problem === 'chain' ? '2' : datum.problem === 'unbumpercars' ? '3' : ''",
      "as": "order"
    },
    {
      "calculate": "datum.solver === 'sqp' ? 'SQP' : 'IPOPT'",
      "as": "solver_name"
    },
    {
      "calculate": "datum.name + ', ' + datum.solver_name",
      "as": "pair"
    },
    {
      "calculate": "2 * datum.order + (datum.solver === 'sqp' ? 0 : 1)",
      "as": "rank"
    },
    {
      "calculate": "datum.metric === 'solver_time_ms' ? 'Total solve time' : 'Function evaluation'",
      "as": "measure"
    }
  ],
  "width": 560,
  "height": {
    "step": 17
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "datum": 1
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "p10",
          "type": "quantitative",
          "title": "Paired per-step speedup (CasADi time ÷ Scaly time)",
          "scale": {
            "type": "log",
            "domain": [
              0.8,
              12
            ],
            "nice": false
          },
          "axis": {
            "format": "~r",
            "values": [
              1,
              2,
              5,
              10
            ]
          }
        },
        "y": {
          "field": "pair",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "rank",
            "op": "min"
          }
        },
        "color": {
          "field": "measure",
          "title": null,
          "scale": {
            "domain": [
              "Total solve time",
              "Function evaluation"
            ],
            "range": [
              "#0b0b0b",
              "#898781"
            ]
          }
        },
        "tooltip": [
          {
            "field": "pair",
            "title": "Controller"
          },
          {
            "field": "measure",
            "title": "Measure"
          },
          {
            "field": "median",
            "title": "Median speedup",
            "format": ".3f"
          },
          {
            "field": "p10",
            "title": "10th percentile",
            "format": ".3f"
          },
          {
            "field": "p90",
            "title": "90th percentile",
            "format": ".3f"
          },
          {
            "field": "steps",
            "title": "Paired steps"
          },
          {
            "field": "iteration_mismatches",
            "title": "Iteration mismatches"
          }
        ],
        "yOffset": {
          "field": "measure",
          "scale": {
            "domain": [
              "Total solve time",
              "Function evaluation"
            ]
          }
        },
        "x2": {
          "field": "p90"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "size": 90,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "median",
          "type": "quantitative",
          "title": "Paired per-step speedup (CasADi time ÷ Scaly time)",
          "scale": {
            "type": "log",
            "domain": [
              0.8,
              12
            ],
            "nice": false
          },
          "axis": {
            "format": "~r",
            "values": [
              1,
              2,
              5,
              10
            ]
          }
        },
        "y": {
          "field": "pair",
          "type": "nominal",
          "title": null,
          "sort": {
            "field": "rank",
            "op": "min"
          }
        },
        "color": {
          "field": "measure",
          "title": null,
          "scale": {
            "domain": [
              "Total solve time",
              "Function evaluation"
            ],
            "range": [
              "#0b0b0b",
              "#898781"
            ]
          }
        },
        "shape": {
          "field": "measure",
          "title": null,
          "scale": {
            "domain": [
              "Total solve time",
              "Function evaluation"
            ],
            "range": [
              "circle",
              "diamond"
            ]
          }
        },
        "tooltip": [
          {
            "field": "pair",
            "title": "Controller"
          },
          {
            "field": "measure",
            "title": "Measure"
          },
          {
            "field": "median",
            "title": "Median speedup",
            "format": ".3f"
          },
          {
            "field": "p10",
            "title": "10th percentile",
            "format": ".3f"
          },
          {
            "field": "p90",
            "title": "90th percentile",
            "format": ".3f"
          },
          {
            "field": "steps",
            "title": "Paired steps"
          },
          {
            "field": "iteration_mismatches",
            "title": "Iteration mismatches"
          }
        ],
        "yOffset": {
          "field": "measure",
          "scale": {
            "domain": [
              "Total solve time",
              "Function evaluation"
            ]
          }
        }
      }
    }
  ]
}
