{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "sweep.csv",
    "format": {
      "type": "csv",
      "parse": {
        "size": "number",
        "runtime_ns": "number",
        "nnz": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "indexof(['race_cars', 'npmpc', 'chain', 'unbumpercars'], datum.workload)",
      "as": "order"
    },
    {
      "filter": "datum.order >= 0"
    },
    {
      "calculate": "['Race-car MPC, horizon N', 'Neural-process MPC, horizon N', 'Chain of masses, M masses', 'Unbumpercars, C cars'][datum.order]",
      "as": "problem"
    },
    {
      "calculate": "{'scaly': 'Scaly', 'casadi_sx': 'CasADi SX', 'casadi_mx': 'CasADi MX', 'casadi_call_mx': 'CasADi MX with calls', 'casadi_map_sx': 'CasADi mapped SX', 'casadi_mx_gemm': 'CasADi MX with GEMM'}[datum.backend]",
      "as": "encoding"
    },
    {
      "calculate": "datum.runtime_status === 'ok' ? datum.runtime_ns / 1000 : null",
      "as": "us"
    },
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "us",
          "as": "us"
        },
        {
          "op": "max",
          "field": "nnz",
          "as": "nnz"
        }
      ],
      "groupby": [
        "problem",
        "order",
        "workload",
        "size",
        "backend",
        "encoding"
      ]
    },
    {
      "calculate": "datum.backend === 'scaly' ? datum.us : null",
      "as": "scaly_us"
    },
    {
      "calculate": "datum.backend !== 'scaly' && isValid(datum.us) ? 1 : 0",
      "as": "casadi_timed"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "scaly_us",
          "as": "reference_us"
        },
        {
          "op": "sum",
          "field": "casadi_timed",
          "as": "casadi_cells"
        }
      ],
      "groupby": [
        "workload",
        "size"
      ]
    }
  ],
  "facet": {
    "field": "problem",
    "type": "nominal",
    "title": null,
    "sort": {
      "field": "order",
      "op": "min"
    }
  },
  "columns": 2,
  "resolve": {
    "scale": {
      "x": "independent"
    }
  },
  "spec": {
    "width": 300,
    "height": 170,
    "layer": [
      {
        "mark": {
          "type": "rule",
          "color": "#898781",
          "strokeWidth": 1
        },
        "encoding": {
          "y": {
            "datum": 1
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.backend !== 'scaly' && isValid(datum.us) && isValid(datum.reference_us)"
          },
          {
            "aggregate": [
              {
                "op": "min",
                "field": "us",
                "as": "casadi_us"
              },
              {
                "op": "argmin",
                "field": "us",
                "as": "fastest"
              }
            ],
            "groupby": [
              "size",
              "reference_us"
            ]
          },
          {
            "calculate": "datum.fastest.encoding",
            "as": "encoding"
          },
          {
            "calculate": "datum.fastest.nnz",
            "as": "nnz"
          },
          {
            "calculate": "datum.casadi_us / datum.reference_us",
            "as": "speedup"
          }
        ],
        "encoding": {
          "x": {
            "field": "size",
            "type": "quantitative",
            "title": "Size",
            "scale": {
              "type": "log",
              "nice": false
            },
            "axis": {
              "format": "~g",
              "grid": false,
              "tickCount": 6
            }
          },
          "y": {
            "field": "speedup",
            "type": "quantitative",
            "title": "Scaly speedup over CasADi",
            "scale": {
              "type": "log",
              "domainMin": 0.5,
              "nice": false,
              "padding": 10
            },
            "axis": {
              "values": [
                0.5,
                1,
                2,
                5,
                10,
                20,
                50,
                100
              ],
              "labelExpr": "datum.label + '×'"
            }
          }
        },
        "layer": [
          {
            "mark": {
              "type": "line",
              "color": "#52514e",
              "strokeWidth": 1.5
            }
          },
          {
            "mark": {
              "type": "point",
              "stroke": "#ffffff",
              "strokeWidth": 1.5,
              "size": 90,
              "opacity": 1
            },
            "encoding": {
              "color": {
                "field": "encoding",
                "title": "Fastest CasADi encoding",
                "scale": {
                  "domain": [
                    "CasADi SX",
                    "CasADi MX",
                    "CasADi MX with calls",
                    "CasADi mapped SX",
                    "CasADi MX with GEMM"
                  ],
                  "range": [
                    "#eb6834",
                    "#2a78d6",
                    "#eda100",
                    "#e87ba4",
                    "#4a3aa7"
                  ]
                }
              },
              "shape": {
                "field": "encoding",
                "title": "Fastest CasADi encoding",
                "scale": {
                  "domain": [
                    "CasADi SX",
                    "CasADi MX",
                    "CasADi MX with calls",
                    "CasADi mapped SX",
                    "CasADi MX with GEMM"
                  ],
                  "range": [
                    "square",
                    "triangle-up",
                    "diamond",
                    "triangle-down",
                    "cross"
                  ]
                }
              },
              "tooltip": [
                {
                  "field": "size",
                  "title": "Size"
                },
                {
                  "field": "nnz",
                  "title": "Hessian nonzeros",
                  "format": ","
                },
                {
                  "field": "reference_us",
                  "title": "Scaly, µs",
                  "format": ",.4~r"
                },
                {
                  "field": "casadi_us",
                  "title": "Fastest CasADi, µs",
                  "format": ",.4~r"
                },
                {
                  "field": "encoding",
                  "title": "Fastest CasADi encoding"
                },
                {
                  "field": "speedup",
                  "title": "Speedup",
                  "format": ".2f"
                }
              ]
            }
          }
        ]
      },
      {
        "transform": [
          {
            "filter": "datum.backend === 'scaly' && isValid(datum.us) && datum.casadi_cells === 0"
          },
          {
            "joinaggregate": [
              {
                "op": "min",
                "field": "size",
                "as": "first"
              }
            ],
            "groupby": [
              "workload"
            ]
          },
          {
            "calculate": "'every encoding reached the 180 s compile limit here or at a smaller size'",
            "as": "outcome"
          }
        ],
        "encoding": {
          "x": {
            "field": "size",
            "type": "quantitative",
            "scale": {
              "type": "log",
              "nice": false
            }
          },
          "y": {
            "value": 160
          }
        },
        "layer": [
          {
            "mark": {
              "type": "point",
              "shape": "cross",
              "angle": 45,
              "size": 80,
              "strokeWidth": 2,
              "color": "#52514e"
            },
            "encoding": {
              "tooltip": [
                {
                  "field": "size",
                  "title": "Size"
                },
                {
                  "field": "us",
                  "title": "Scaly, µs",
                  "format": ",.4~r"
                },
                {
                  "field": "outcome",
                  "title": "CasADi"
                }
              ]
            }
          },
          {
            "transform": [
              {
                "filter": "datum.size === datum.first"
              }
            ],
            "mark": {
              "type": "text",
              "align": "right",
              "dx": -10,
              "text": "CasADi did not compile",
              "color": "#52514e"
            }
          }
        ]
      }
    ]
  }
}
