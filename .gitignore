# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Worktrees
.worktrees
.claude/worktrees

# Built native artifacts (generated by hatch_build.py)
src/scaly/lib/
src/scaly/include/

# Third-party sources (cloned during build)
third_party/
plugins/*/third_party/
plugins/*/.build_key
plugins/*/src/*/lib/
plugins/*/src/*/include/
plugins/*/src/*/_piqp_ext*.so
plugins/*/src/*/_piqp_ext.pyi
plugins/*/src/*/licenses/

# Local benchmark outputs
benchmarks/results/

# CasADi's JIT writes these into the working directory and does not always clean up
jit_tmp*.c
tmp_casadi_compiler_shell*

# docs
site/
.wrangler

package-placeholders

# Agent instructions and merge-gate words that must not be public
AGENTS.local.md
CLAUDE.local.md
.config/private-names
skills-lock.json
